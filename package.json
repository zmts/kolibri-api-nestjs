{
  "name": "kolibri-api-nestjs",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npm run start:api-main",
    "lint": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" --no-error-on-unmatched-pattern \"vitest*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" --no-error-on-unmatched-pattern \"vitest*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"apps/**/tsconfig*.json\" \"libs/**/*.ts\" \"libs/**/tsconfig*.json\" \"*.json\" eslint.config.mjs --no-error-on-unmatched-pattern \"vitest*.ts\"",
    "build:api-main": "nest build api-main",
    "start:api-main": "node dist/apps/api-main/main.js",
    "start:dev:api-main": "nest start api-main --watch",
    "build:common": "nest build common",
    "build:config": "nest build config",
    "build:core": "nest build core",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@rspack/core": "2.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "fork-ts-checker-webpack-plugin": "9.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "webpack-node-externals": "3.0.0"
  }
}
