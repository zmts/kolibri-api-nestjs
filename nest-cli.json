{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-main/src",
  "root": "apps/api-main",
  "monorepo": true,
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/api-main/tsconfig.app.json",
    "builder": "rspack"
  },
  "projects": {
    "api-main": {
      "type": "application",
      "root": "apps/api-main",
      "entryFile": "main",
      "sourceRoot": "apps/api-main/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-main/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    }
  }
}
